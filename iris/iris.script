zn "%SYS"
do ##class(SYS.Container).QuiesceForBundling()
set sc = 1
if ##class(%SYS.Namespace).Exists("HSLIB") { zn "HSLIB" set sc = $classmethod("HS.Util.Installer.Foundation", "Install", "APP") }
if '$SYSTEM.Status.IsOK(sc) do $SYSTEM.OBJ.DisplayError(sc)
if '$SYSTEM.Status.IsOK(sc) halt
zn "APP"
set sc = $SYSTEM.OBJ.LoadDir("/opt/irisapp/fhir-r5/Model", "ck", , 1)
if '$SYSTEM.Status.IsOK(sc) do $SYSTEM.Status.DisplayError(sc)
if '$SYSTEM.Status.IsOK(sc) halt
set sc = $SYSTEM.OBJ.LoadDir("/opt/irisapp/src/App", "ck", , 1)
if '$SYSTEM.Status.IsOK(sc) do $SYSTEM.OBJ.DisplayError(sc)
if '$SYSTEM.Status.IsOK(sc) halt
set sc = ##class(App.Setup.Catalog).Run()
if '$SYSTEM.Status.IsOK(sc) do $SYSTEM.Status.DisplayError(sc)
if '$SYSTEM.Status.IsOK(sc) halt
set sc = ##class(App.Setup.HeaderDefinitions).Run()
if '$SYSTEM.Status.IsOK(sc) do $SYSTEM.Status.DisplayError(sc)
if '$SYSTEM.Status.IsOK(sc) halt
set sc = ##class(Ens.Director).SetAutoStart("App.Interop.Production")
if '$SYSTEM.Status.IsOK(sc) do $SYSTEM.OBJ.DisplayError(sc)
if '$SYSTEM.Status.IsOK(sc) halt
set marker = ##class(%Stream.FileCharacter).%New()
set sc = marker.LinkToFile("/opt/irisapp/.build-success")
if '$SYSTEM.Status.IsOK(sc) halt
do marker.Write("ok")
set sc = marker.%Save()
if '$SYSTEM.Status.IsOK(sc) halt
do marker.%Close()
halt
